---
import '../styles/global.css';
import {
  UsersRound,
  Workflow,
  MonitorCog,
  Network
} from 'lucide-astro';

const pillars = [
  {
    icon: UsersRound,
    title: 'People',
    description: 'Develop talent, recognize potential, and create opportunities for individuals and teams to grow.'
  },
  {
    icon: Workflow,
    title: 'Processes',
    description: 'Develop effective practices, identify operational friction, and drive continual improvement.'
  },
  {
    icon: MonitorCog,
    title: 'Technology',
    description: 'Manage technology services, align systems with business needs, and support reliable operations.'
  },
  {
    icon: Network,
    title: 'Organizations',
    description: 'Navigate complex relationships, coordinate across business functions, and support organizational growth.'
  }
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#10283b" />
  <meta name="description" content="John White — IT and organizational leadership, connecting people, processes, and technology." />
  <title>John White | People · Processes · Technology</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

</head>
<body>

  <header class="nav">
    <div class="container nav-inner">
      <a class="brand" href="#home">john<span>white</span>.ca</a>
      <button class="menu-toggle" aria-label="Toggle navigation" aria-expanded="false">☰</button><nav class="links" aria-label="Main navigation"><a href="#home">Home</a><a href="#about">About</a><a href="#experience">Experience</a><a href="#contact">Contact</a><a class="button" href="#contact">Let's Connect</a></nav>
    </div>
  </header>

  <main>
    <section id="home" class="hero">
      <div class="container hero-inner">
        <div>
          <div class="eyebrow">IT LEADERSHIP · PEOPLE · PROCESSES · TECHNOLOGY</div>
          <h1>
            Experienced in technology.<br class="desktop-break" />
            Focused on people.<br class="desktop-break" />
            Driven by <span>progress.</span>
          </h1>

          <p>With more than 26 years in IT and over six years in IT management, I bring technical experience, people development, and operational understanding together to help organizations work more effectively.</p>

          <div class="actions"><a class="button" href="#experience">Explore My Experience →</a><a class="button alt" href="#about">About Me</a></div>

        </div>
        <div class="hero-quote">Find the right people.<br/>Create the right conditions.<br/>Remove what gets in the way.<br/>Let them grow.</div>
      </div>
    </section>
    <!--div class="strip">
      <div class="container strip-inner">
        <span>Develop People</span>
        <span>Improve Processes</span>
        <span>Enable Technology</span>
        <span>Support Organizational Growth</span>
      </div>
    </div-->

  <section id="about" class="section">
    <div class="container about">
      <div class="portrait">
        <img
          src="/images/JohnWhite_Portrait.jpg"
          alt="John White"
          loading="lazy"
        />
      </div>
      <div>
        <div class="eyebrow">About John</div>
        <h2>Experience built through practice. Leadership shaped by people.</h2>
        <p>My career in information technology spans technical operations, service management, process development, team leadership, and broader organizational initiatives.</p>
        <p>Continual improvement has been a consistent part of how I work. From developing operational practices to supporting people and navigating complex business environments, I look for opportunities to strengthen the systems, relationships, and processes that help organizations succeed.</p>
        <a class="text-link" href="#experience">Explore My Experience →</a>
      </div>
    </div>
  </section>

  <!--section class="section values">
    <div class="container">
      <div class="eyebrow">How I Add Value</div>
      <h2>A balanced approach to complex challenges.</h2>
      <p>I bring together people, processes, technology, and organizational understanding to address challenges, improve operations, and create opportunities for meaningful progress.</p>
      <div class="cards">{pillars.map((pillar) => {
        const Icon = pillar.icon;

        return (
          <div class="card">
            <div class="card-icon">
              <Icon size={32} strokeWidth={1.75} />
            </div>
            <h3>{pillar.title}</h3>
            <p>{pillar.description}</p>
          </div>
        );
      })}
      </div>
    </div>
  </section-->

  <section class="experience section" id="experience">
    <div class="container">

      <div class="experience-content">
        <div class="eyebrow">EXPERIENCE IN ACTION</div>

        <h2>Experience that extends beyond technology.</h2>

        <p class="experience-intro">
          Practical experience across technology operations, service management, people development, and complex organizational initiatives.
        </p>

        <div class="experience-highlights">

          <article class="experience-highlight">
            <span class="experience-number">01</span>

            <div>
              <h3>Developing people and strengthening teams</h3>

              <p>
                Recruiting, mentoring, recognizing potential, and developing team capabilities while establishing practices that support effective service delivery.
              </p>
            </div>
          </article>

          <article class="experience-highlight">
            <span class="experience-number">02</span>

            <div>
              <h3>Leading technology and operational initiatives</h3>

              <p>
                Planning infrastructure, establishing remote facilities, supporting manufacturing expansion, and integrating technology through organizational change.
              </p>
            </div>
          </article>

          <article class="experience-highlight">
            <span class="experience-number">03</span>

            <div>
              <h3>Improving processes and navigating complexity</h3>

              <p>
                Developing service management practices, identifying operational risks, and coordinating across international facilities, business functions, and independently managed teams.
              </p>
            </div>
          </article>

        </div>

        <!--a href="/experience" class="experience-link">
          Explore my experience <span aria-hidden="true">→</span>
        </a-->

      </div>

    </div>
  </section>

  <!--section class="section approach" id="approach">
    <div class="container">
      <div class="approach-grid">

        <div class="approach-content">
          <div class="eyebrow">A SERVICE-ORIENTED APPROACH</div>

          <h2>Creating opportunities for people and organizations to grow.</h2>

          <p>
            I believe effective leadership begins with understanding
            people, recognizing potential, and aligning individual
            strengths with organizational needs.
          </p>

          <p>
            That also means recognizing friction — whether in roles,
            relationships, processes, or systems — and working to
            address it thoughtfully.
          </p>

          <p>
            My responsibility is to create the conditions for people
            to contribute and develop. Their growth belongs to them.
          </p>
        </div>

        <blockquote class="approach-quote">
          <p>
            “Recognize potential.<br />
            Create opportunity.<br />
            Respect ownership.”
          </p>
        </blockquote>

      </div>
    </div>
  </section-->

  <section class="contact section" id="contact">
    <div class="container">
      <div class="contact-inner">

        <div class="contact-content">
          <div class="eyebrow">LET'S CONNECT</div>

          <h2>Let's explore what's possible.</h2>

          <p>
            Open to conversations about IT leadership, broader
            management opportunities, and meaningful organizational growth.
          </p>
        </div>

        <div class="contact-actions">
          <a
            href="mailto:connect@johnwhite.ca"
            class="button contact-button"
          >
            Send an Email →
          </a>

          <a
            href="https://www.linkedin.com/in/jwit/"
            class="button contact-linkedin"
            target="_blank"
            rel="noopener noreferrer"
          >
            LinkedIn ↗
          </a>
        </div>

      </div>
    </div>
  </section>

</main>

<footer class="footer">
  <div class="container footer-inner">

    <span>© {new Date().getFullYear()} John White</span>

    <div class="footer-links">
      <a href="mailto:connect@johnwhite.ca">Email</a>

      <a
        href="https://www.linkedin.com/in/jwit/"
        target="_blank"
        rel="noopener noreferrer"
      >
        LinkedIn
      </a>

      <a href="#home">Back to top ↑</a>
    </div>

  </div>
</footer>

<script>const b=document.querySelector('.menu-toggle');const n=document.querySelector('.links');b?.addEventListener('click',()=>{const open=n?.classList.toggle('open');b?.setAttribute('aria-expanded',String(!!open))});n?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{n.classList.remove('open');b?.setAttribute('aria-expanded','false')}));</script>
</body></html>
