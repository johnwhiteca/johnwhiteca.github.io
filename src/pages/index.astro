---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Contact from '../components/Contact.astro';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#10283b" />
  <meta name="description" content="John White — IT and organizational leadership, connecting people, processes, and technology." />
  <title>John White | People · Processes · Technology</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

</head>
<body>
  <Header current="home" />

  <main>
    <section id="home" class="hero">
      <div class="container hero-inner">
        <div>
          <div class="eyebrow">IT LEADERSHIP · PEOPLE · PROCESSES · TECHNOLOGY</div>
          <h1>
            Experienced in technology.<br class="desktop-break" />
            Focused on people.<br class="desktop-break" />
            Driven by <span>progress.</span>
          </h1>

          <p>With more than 26 years in IT and over six years in IT management, I bring technical experience, people development, and operational understanding together to help organizations work more effectively.</p>

          <div class="actions"><a class="button" href="#experience">Explore My Experience →</a><a class="button alt" href="#about">About Me</a></div>

        </div>
        <div class="hero-quote">Find the right people.<br/>Create the right conditions.<br/>Remove what gets in the way.<br/>Let them grow.</div>
      </div>
    </section>

  <section id="about" class="section">
    <div class="container about">
      <div class="portrait">
        <img
          src="/images/JohnWhite_Portrait.jpg"
          alt="John White"
          loading="lazy"
        />
      </div>
      <div>
        <div class="eyebrow">About John</div>
        <h2>Experience built through practice. Leadership shaped by people.</h2>
        <p>My career in information technology spans technical operations, service management, process development, team leadership, and broader organizational initiatives.</p>
        <p>Continual improvement has been a consistent part of how I work. From developing operational practices to supporting people and navigating complex business environments, I look for opportunities to strengthen the systems, relationships, and processes that help organizations succeed.</p>
        <a class="text-link" href="#experience">Experience Summary →</a>
      </div>
    </div>
  </section>

  <section class="experience section" id="experience">
    <div class="container">

      <div class="experience-content">
        <div class="eyebrow">EXPERIENCE IN ACTION</div>

        <h2>Experience that extends beyond technology.</h2>

        <p class="home-experience-intro">
          Practical experience across technology operations, service management, people development, and complex organizational initiatives.
        </p>

        <div class="home-experience-highlights">

          <article class="home-experience-highlight">
            <span class="home-experience-number">01</span>

            <div>
              <h3>Developing people and strengthening teams</h3>

              <p>
                Recruiting, mentoring, recognizing potential, and developing team capabilities while establishing practices that support effective service delivery.
              </p>
            </div>
          </article>

          <article class="home-experience-highlight">
            <span class="home-experience-number">02</span>

            <div>
              <h3>Leading technology and operational initiatives</h3>

              <p>
                Planning infrastructure, establishing remote facilities, supporting manufacturing expansion, and integrating technology through organizational change.
              </p>
            </div>
          </article>

          <article class="home-experience-highlight">
            <span class="home-experience-number">03</span>

            <div>
              <h3>Improving processes and navigating complexity</h3>

              <p>
                Developing service management practices, identifying operational risks, and coordinating across international facilities, business functions, and independently managed teams.
              </p>
            </div>
          </article>

        </div>

        <a href="/experience" class="experience-link">
          Explore my experience <span aria-hidden="true">→</span>
        </a>

      </div>

    </div>
  </section>
  <Contact />

</main>
<Footer />
</body></html>
